{
  "name": "escapequeue",
  "version": "1.0.0",
  "private": true,
  "description": "EscapeQueue monorepo: Python API, UI and Terraform.",
  "workspaces": [
    "ui"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "cd api && .venv/bin/python -m uvicorn app.main:create_app --factory --reload --port ${PORT:-3000}",
    "dev:ui": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "test:ui": "npm test -w ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
